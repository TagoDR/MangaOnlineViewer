{
  "name": "mangaonlineviewer",
  "description": "Userscript that helps to read Manga faster by loading all the pages at once",
  "version": "46.0.0",
  "scripts": {
    "start": "vite --host",
    "build:dev": "vite build --mode dev",
    "build:release": "vite build --mode main && vite build --mode adult",
    "build:min": "vite build --mode main-min && vite build --mode adult-min",
    "build:standalone": "vite build --mode standalone",
    "build:all": "vite build --mode main && vite build --mode adult && vite build --mode main-min && vite build --mode adult-min && vite build --mode standalone",
    "biome": "biome check --fix .",
    "storybook": "storybook dev -p 6006"
  },
  "author": "TagoDR",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TagoDR/MangaOnlineViewer.git"
  },
  "keywords": ["manga", "reader", "viewer", "online", "loader"],
  "bugs": "https://github.com/TagoDR/MangaOnlineViewer/issues",
  "homepage": "https://github.com/TagoDR/MangaOnlineViewer#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@types/tampermonkey": "^5.5.0",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "rollup-plugin-external-globals": "^0.13.0",
    "storybook": "^10.6.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "userscript-metadata-generator": "^0.2.4",
    "vite": "^8.3.4",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-svg-loader": "^5.1.3"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@gerhobbelt/keyscss": "^1.1.3-6",
    "@nanostores/lit": "^0.2.3",
    "@nanostores/logger": "^1.1.0",
    "blob-util": "^2.0.2",
    "bowser": "^2.14.1",
    "colorjs.io": "^0.7.1",
    "file-saver": "^2.0.5",
    "hotkeys-js": "^4.0.8",
    "jszip": "=3.9.1",
    "lit": "^3.3.3",
    "lodash": "^4.18.1",
    "nanostores": "^1.5.5",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0"
  },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "arrowParens": "avoid",
    "endOfLine": "crlf",
    "singleAttributePerLine": true
  },
  "allowScripts": {
    "esbuild": true
  }
}
